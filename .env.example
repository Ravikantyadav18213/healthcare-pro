# ==================================================
# Copy this file to .env and fill in real values.
# ==================================================

NODE_ENV=development

PORT=5000
CLIENT_URL=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL=20m
REFRESH_TOKEN_DAYS=7

AUTH_MODE=cookie
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

BCRYPT_ROUNDS=10

ADMIN_EMAIL=admin@healthcarepro.io
ADMIN_PASSWORD=change-this-before-deploying
ADMIN_NAME=System Administrator

MAX_UPLOAD_BYTES=5242880

# ===================================================================
# DATABASE (Turso / libSQL)
#
# Leave both unset for local dev - falls back to a local libSQL file
# at server/data/healthcare.db, so `npm run dev:full` needs no cloud
# account. Required for a Vercel deployment (no local disk there):
# add the Turso native integration from the Vercel dashboard's
# Storage tab, which sets both of these for you automatically.
# ===================================================================
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ===================================================================
# FILE STORAGE (Vercel Blob)
#
# Leave unset for local dev - reports and chat attachments are written
# to UPLOAD_DIR on local disk instead. Required for a Vercel
# deployment (no persistent disk there): enable Blob from the Vercel
# dashboard's Storage tab, which sets this for you automatically.
# ===================================================================
BLOB_READ_WRITE_TOKEN=

# Local-disk fallback path, only used when BLOB_READ_WRITE_TOKEN is unset.
# UPLOAD_DIR=server/uploads

# ===================================================================
# SHARED STATE (Upstash Redis)
#
# Backs the login rate limiter, the password-reset OTP guess counter,
# and the JWT revocation denylist. Leave unset for local dev - falls
# back to an in-process Map, which only stays correct for a single
# server instance. Required for a Vercel deployment (every request can
# land on a different instance): add the Upstash native integration
# from the Vercel dashboard's Storage tab, which sets both of these
# for you automatically.
# ===================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===================================================================
# REALTIME (Pusher Channels)
#
# Live chat, notifications and dashboard updates. Leave unset to turn
# realtime off entirely - the rest of the app (every REST endpoint)
# works fully without it, just without live push. Free "Sandbox" app
# at https://dashboard.pusher.com -> Channels -> Create app.
# VITE_PUSHER_KEY/CLUSTER are the same key/cluster, exposed to the
# frontend (Pusher's app key is not a secret - the app secret below
# is, and never goes to the browser).
# ===================================================================
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=

# ===================================================================
# CRON (scheduled jobs)
#
# Required in production so /api/cron/* cannot be triggered by anyone
# else. Generate with the same command as JWT_SECRET above.
#
# On Vercel: set this env var, then Vercel's own daily Cron Job (see
# vercel.json) authenticates automatically. For the 15-minute
# appointment-reminder sweep - finer than Vercel's Hobby-plan cron
# allows - point a free pinger (e.g. https://cron-job.org) at
# POST /api/cron/reminders every 15 minutes with the header
# `x-cron-secret: <this value>`.
#
# Leave unset in local dev - npm run dev:full runs the reminder sweep
# on its own setInterval instead, same as before this was needed.
# ===================================================================
CRON_SECRET=

# Google Sign-In. Leave blank to leave the feature off — the button
# hides itself on the frontend and the API refuses the endpoint rather
# than crashing. Get a client ID from https://console.cloud.google.com/apis/credentials
# (Create Credentials -> OAuth client ID -> Web application), with
# CLIENT_URL above listed under "Authorized JavaScript origins". No
# redirect URI is needed for the Sign In With Google button.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Outgoing mail for password-reset OTP codes. MAIL_PASS must be a
# Gmail "App Password" (16 characters, from
# https://myaccount.google.com/apppasswords - needs 2-Step
# Verification on first), never the account's real login password.
# Verify the setup with: npm run mail:test
# Leave blank to leave email off - forgot-password then hands the
# code straight back in the API response in development only.
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Only needed for a non-Gmail SMTP provider. Leave unset for Gmail.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SECURE=false

# Echo the password-reset code in the API response when mail cannot
# send, so the flow is testable without a mail account. Account
# takeover primitive on a public endpoint - keep false unless you are
# actively testing, and it is ignored when NODE_ENV=production.
ALLOW_DEV_OTP=false


# ===================================================================
# WHATSAPP (appointment reminders)
#
# Optional. With nothing set here, reminders still go out over email
# and in-app - only the WhatsApp channel is skipped.
#
# Twilio (default). The sandbox lives in the LEGACY console:
#   https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
# The "from" number is whatsapp:+14155238886 - keep the whatsapp:
# prefix, it is what selects the channel.
#
# Each recipient must first WhatsApp "join <your-code>" to that number.
# The join expires after 3 days and has to be repeated.
#
# IMPORTANT - why sandbox success can be misleading. That join message
# opens a 24-hour "customer service window", and free-form text is only
# legal inside one. Reminders are sent by a timer to patients who have
# NOT messaged the hospital, so in production they fall outside the
# window and WhatsApp refuses them (Twilio error 63016) unless sent as
# a pre-approved template. Testing minutes after joining always
# succeeds and hides this completely.
#
# Going to production therefore needs, in this order: a registered
# WhatsApp sender on a Meta-verified business (the long pole), then two
# approved UTILITY templates, then template support in whatsapp.js.
# Email reminders keep working throughout regardless.
# ===================================================================
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Meta Cloud API instead of Twilio: set WHATSAPP_PROVIDER=meta
# META_WHATSAPP_TOKEN=
# META_WHATSAPP_PHONE_ID=

# Prepended to patient numbers stored without a country code.
DEFAULT_COUNTRY_CODE=91


# ===================================================================
# APPOINTMENT REMINDERS + LOW-STOCK DIGEST
# ===================================================================
REMINDER_ENABLED=true
REMINDER_SWEEP_MINUTES=15

# Hours before an appointment to remind at. "24,2" = a day ahead and
# again two hours ahead.
REMINDER_LEAD_HOURS=24,2

# Pharmacy stock at or below this many units emails the admins, at
# most once a day.
LOW_STOCK_ALERT_ENABLED=true
LOW_STOCK_THRESHOLD=50


# ===================================================================
# TWO-FACTOR SIGN-IN (email OTP)
#
# Users opt in individually from their profile; this only controls
# whether the feature is offered. Needs MAIL_USER/MAIL_PASS above.
# ===================================================================
TWO_FACTOR_ENABLED=true
TWO_FACTOR_MINUTES=10


# ===================================================================
# VIDEO CONSULTATION
#
# Jitsi Meet needs no account. Point this at a self-hosted instance
# instead of the public server if you have one.
# ===================================================================
JITSI_DOMAIN=meet.jit.si


# ===================================================================
# ONLINE PAYMENTS (Razorpay)
#
# Optional. Without these the "Pay" button is not offered at all and
# invoices stay a manual, front-desk process.
#
# dashboard.razorpay.com -> Settings -> API Keys. Test keys start
# with rzp_test_ - nothing here tells them apart from live keys, so
# check which pair you are deploying.
# ===================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


# Where links inside emails point.
APP_URL=http://localhost:5173

# Only needed when the frontend and API are on different origins -
# local dev (Vite on :5173, Express on :5000) needs this. On Vercel
# leave it UNSET: the frontend and API share one deployment/domain
# (see vercel.json), so the code's own same-origin default ("/api")
# is correct there.
VITE_API_URL=http://localhost:5000/api
