{
  "name": "healthcare-pro",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "HealthCare Pro — hospital management system (React + Vite frontend, Express + SQLite backend)",
  "scripts": {
    "dev": "vite",
    "server": "nodemon server/index.js",
    "server:start": "node server/index.js",
    "dev:full": "concurrently -n \"api,web\" -c \"cyan,magenta\" \"npm run server\" \"npm run dev\"",
    "db:seed": "node -e \"import('./server/seed.js').then(m => { m.default(); console.log('seed complete'); })\"",
    "db:reset": "node -e \"import('node:fs').then(fs => { fs.rmSync('server/data', { recursive: true, force: true }); console.log('database removed - restart the server to recreate it'); })\"",
    "build": "vite build",
    "preview": "vite preview",
    "mail:test": "node server/scripts/mailTest.js",
    "whatsapp:test": "node server/scripts/whatsappTest.js"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.4.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^11.0.24",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.6",
    "pdfkit": "^0.20.2",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-router-dom": "^6.22.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.4",
    "nodemon": "^3.1.14",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0"
  }
}
